{
  "name": "spesr",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:backend": "cd ../pb && air",
    "backend": "cd ../pb && ./spesr serve --publicDir=../sk/build",
    "build": "vite build",
    "build:backend": "cd ../pb && go build",
    "typegen": "pocketbase-typegen --db ../pb/pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts",
    "generate:sdk": "swagger2openapi ../pb/docs/swagger.yaml -o ../pb/docs/openapi.yaml && openapi-typescript ../pb/docs/openapi.yaml --output ./src/lib/pocketbase/generated-sdk.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@lucide/svelte": "^1.79.0",
    "@openapitools/openapi-generator-cli": "^2.43.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "openapi-typescript": "^7.13.0",
    "pocketbase-typegen": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-lightbox": "^1.1.9",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "type": "module",
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "js-yaml": "^5.5.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0",
    "papaparse": "^5.7.1",
    "pocketbase": "^0.29.0",
    "svelte-radix": "^3.0.2",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^13.0.0"
    }
  }
}
